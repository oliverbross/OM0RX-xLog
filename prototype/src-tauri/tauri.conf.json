{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OM0RX-xLog Prototype",
  "version": "0.1.0",
  "identifier": "com.oliverbross.xlog.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "OM0RX-xLog — P1 Prototype (synthetic data)",
      "width": 1440, "height": 940, "minWidth": 1000, "minHeight": 720
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": "all",
    "externalBin": ["binaries/xlog-prototype-worker"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "shortDescription": "Isolated architecture prototype, not the stable xLog release",
    "category": "Utility"
  }
}
