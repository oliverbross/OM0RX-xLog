{
  "waitFor": [
    "CLOSE-RUST-BUILDS",
    "CLOSE-SWIFT-BUILDS",
    "CLOSE-FRONT-BUILDS",
    "CLOSE-WORKER-BUILDS"
  ],
  "checks": [
    {
      "id": "CLOSE-PYTHON",
      "timeout": 500,
      "command": [
        "/usr/bin/time",
        "-l",
        "env",
        "PYTHONPATH=python",
        "XLOG_CONTEST_N1MM_UDP_ALLOWED=0",
        "python3.12",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "python/tests",
        "-v"
      ]
    },
    {
      "id": "CLOSE-PATCH-FLOORS",
      "timeout": 60,
      "command": [
        "python3.12",
        "-B",
        "tools/check_reviewed_security_patches.py"
      ]
    }
  ]
}
