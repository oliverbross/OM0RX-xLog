{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://om0rx.example/schemas/contest-definition-1.0.0.json",
  "title": "Authored declarative contest definition",
  "description": "Runtime-neutral authoring contract designed to map onto XContestCore ContestRuleMetadata and ContestEntryDescriptor. It is not a general expression language.",
  "type": "object",
  "required": ["definitionSchemaVersion", "identity", "status", "provenance", "metadata", "entry", "policies", "constraints", "goldenScenarios"],
  "properties": {
    "definitionSchemaVersion": {"const": "1.0.0"},
    "identity": {
      "type": "object",
      "required": ["id", "version", "edition", "contentDigest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "version": {"type": "string", "minLength": 1},
        "edition": {"type": "string", "minLength": 1},
        "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "status": {
      "description": "This slice validates drafts only; review and activation require a separate acceptance gate.",
      "enum": ["draft", "source-derived-draft"]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "locator", "revision", "sha256"],
        "properties": {
          "kind": {"enum": ["official-rules", "python-comparator", "operator-authored", "test-fixture"]},
          "locator": {"type": "string"},
          "revision": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["displayName", "cabrilloName", "supportedModes", "supportedBands"]
    },
    "entry": {
      "description": "Maps to the existing ContestEntryDescriptor rather than defining a second UI model.",
      "type": "object",
      "required": ["report", "exchange", "serial", "scorePolicy"]
    },
    "policies": {
      "type": "object",
      "required": ["eligibility", "dupe", "points", "multipliers", "serial", "export"],
      "properties": {
        "dupe": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["once-per-contest", "per-band", "per-band-mode", "none"]}}},
        "points": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["fixed", "bounded-clauses", "unsupported-adapter"]}}},
        "multipliers": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["none", "unique-field", "entity-prefix", "country", "zone", "unsupported-adapter"]}}},
        "serial": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["none", "sequential", "station-resolved", "unsupported-adapter"]}}},
        "export": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["existing-cabrillo-adif", "existing-adif-only", "unsupported-adapter"]}}}
      }
    },
    "constraints": {
      "type": "object",
      "required": ["category", "time", "eligibility", "unresolved"],
      "properties": {"unresolved": {"type": "array", "items": {"type": "string"}}}
    },
    "goldenScenarios": {"type": "array"}
  }
}
